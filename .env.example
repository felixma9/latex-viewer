# Copy to .env and uncomment what you need. Every value is optional.

# Host port for the viewer (default 8585).
# LATEX_WORKSPACE_PORT=8585

# Host interface to listen on (default 127.0.0.1, this computer only).
# The viewer has no login, so only open it on a network you trust,
# e.g. 0.0.0.0 behind Tailscale or a home LAN.
# LATEX_WORKSPACE_BIND=0.0.0.0

# Docker socket for the autoheal container (default /var/run/docker.sock).
# Rootless Docker: /run/user/1000/docker.sock
# Podman:          /run/user/1000/podman/podman.sock
# DOCKER_SOCK=/var/run/docker.sock
